# URL absoluta do site: alimenta canonical, Open Graph, hreflang e sitemap.
# Assada no bundle no build de produção — trocar exige rebuild da imagem web.
VITE_SITE_URL=http://localhost:5174

# Portas publicadas no host.
VITE_PORT=5174
# 5173 costuma estar ocupada pelo dev server do Portfolio.
WEB_HTTP_PORT=8080

# Dono dos arquivos gerados dentro do container. Sem isto, dist/ sai como root.
# Descobrir com: id -u  e  id -g
DOCKER_UID=1000
DOCKER_GID=1000

# Polling do watcher: só necessário onde inotify não atravessa o bind mount
# (WSL2 com o projeto sob /mnt/c). Em Linux nativo deixar 0.
VITE_POLLING=0

# Base da API do Laravel, vista pelo navegador. Vazia = a constelação lê o
# acervo semente de src/data/publications.ts. Use "/" para mesma origem, que é
# o caso tanto em produção (o Nginx serve site e API) quanto em desenvolvimento
# (o Vite faz proxy de /api).
VITE_API_URL=

# Para onde o proxy do dev server manda /api. Nome de serviço do compose.
VITE_API_PROXY=http://web

# Base da API vista pelo prerender, que roda em Node e não tem "mesma origem".
# Precisa ser absoluta. Vazia = o prerender usa o acervo semente.
PRERENDER_API_URL=

# --- Backend (profile "backend") ---
DB_DATABASE=rdm_labs
DB_USERNAME=rdm
DB_PASSWORD=
DB_PORT=5432
TIMEZONE=America/Sao_Paulo

# Administrador do painel, criado pelo seeder. O e-mail também é o allowlist
# do login Google — é o único endereço aceito no callback. Deixe em branco
# aqui e preencha no .env: nenhuma credencial entra no repositório.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Credenciais OAuth do Google, de um "ID do cliente OAuth" no Google Cloud
# Console. GOOGLE_REDIRECT_URI é a URI de redirecionamento autorizada ali —
# <APP_URL>/admin/login/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
