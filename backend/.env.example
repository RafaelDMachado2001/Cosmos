APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=rdm_labs
DB_USERNAME=rdm
DB_PASSWORD=

# O único administrador do painel; criado pelo DatabaseSeeder. O e-mail
# também é o allowlist do login Google — o único endereço aceito no callback.
# Nenhuma credencial fica no repositório: preencha no .env.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Credenciais OAuth do Google. GOOGLE_REDIRECT_URI é a URI de redirecionamento
# autorizada no Google Cloud Console — <APP_URL>/admin/login/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mídia do RDM Studio. `local` grava em storage/app/public (o Nginx serve em
# /storage/); `s3` grava no bucket R2, servido pela CDN em MEDIA_URL.
MEDIA_DISK=local
MEDIA_S3_KEY=
MEDIA_S3_SECRET=
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_URL=

# Como o site público é reconstruído depois de salvar. `local`: o prerender
# grava no volume do Nginx (docker compose). `vercel`: o deploy hook.
SITE_REBUILD_DRIVER=local
VERCEL_DEPLOY_HOOK_URL=

# O tick do Cloud Scheduler (POST /api/internal/tick). Sem os dois, a rota
# recusa tudo; em desenvolvimento quem roda é o `schedule:work` do compose.
SCHEDULER_OIDC_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
