# Variáveis só de produção (Cloud Run). Ficam fora do .env.example de propósito:
# o check:env do frontend exige no backend/.env toda chave de lá, e o docker
# compose não usa nenhuma destas — os padrões delas são os do desenvolvimento.
#
# Em produção não há arquivo .env: o Terraform (infra/) passa estas variáveis
# ao serviço, e os segredos vêm do Secret Manager. `php artisan
# env:assert-production` recusa subir o contêiner se faltar alguma.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://admin.rdmlabs.com.br
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.rdmlabs.com.br

# Mídia do RDM Studio. `local` grava em storage/app/public (o Nginx serve em
# /storage/); `s3` grava no bucket R2, servido pela CDN em MEDIA_URL.
MEDIA_DISK=s3
MEDIA_S3_KEY=
MEDIA_S3_SECRET=
MEDIA_S3_BUCKET=rdm-labs-media
MEDIA_S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
MEDIA_URL=https://media.rdmlabs.com.br

# Como o site público é reconstruído depois de salvar. `local`: o prerender
# grava no volume do Nginx (docker compose). `vercel`: o deploy hook.
SITE_REBUILD_DRIVER=vercel
VERCEL_DEPLOY_HOOK_URL=

# O tick do Cloud Scheduler (POST /api/internal/tick). Sem os dois, a rota
# recusa tudo; em desenvolvimento quem roda é o `schedule:work` do compose.
SCHEDULER_OIDC_AUDIENCE=https://api.rdmlabs.com.br/api/internal/tick
SCHEDULER_SERVICE_ACCOUNT=

# Produção: o painel só em ADMIN_HOST (cookie rdm_admin, preso ao host) e a
# API só em API_HOST. Vazios, tudo responde no mesmo host (docker compose).
ADMIN_HOST=admin.rdmlabs.com.br
API_HOST=api.rdmlabs.com.br

# A borda: o Worker da Cloudflare (infra/cloudflare/edge-worker.js) recebe
# admin. e api. e repassa ao *.run.app com este segredo em X-Edge-Secret.
# Sem ele, o contêiner responde 404 a tudo menos /up.
EDGE_SHARED_SECRET=
