{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    // O Worker da borda (infra/cloudflare) é JS puro, para o Terraform subir
    // sem bundler; o teste o importa e lê os tipos do JSDoc.
    "allowJs": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "vite.prerender.config.ts",
    "vite.admin.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts",
    "e2e",
    "infra"
  ]
}
